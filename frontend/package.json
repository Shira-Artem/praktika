{
  "name": "lunar-dispatch-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --configLoader runner",
    "build": "tsc -b && vite build --configLoader runner",
    "lint": "eslint . --max-warnings 0",
